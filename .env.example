# Copy to .env (`make up` does it for you). .env is git-ignored.
# Every value below is a FICTIONAL, local-only lab value for services bound to 127.0.0.1.
# Never reuse them anywhere else, and never put real credentials in this file.
LAB_ENV=local

# Local Keycloak admin console: http://localhost:8080/admin
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=admin-lab-only

# Lab 01: these match labs/01-oauth-oidc-flows/keycloak/realm-contoso.json
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=contoso
LAB01_BATCH_CLIENT_SECRET=lab-only-batch-secret
LAB01_GATEWAY_CLIENT_SECRET=lab-only-gateway-secret
LAB01_DPOP_CLIENT_SECRET=lab-only-dpop-secret
# Test user for the browser login: alice / the value below
LAB01_ALICE_PASSWORD=alice-lab-only
