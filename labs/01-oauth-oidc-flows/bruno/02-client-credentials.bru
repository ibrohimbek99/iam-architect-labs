meta {
  name: 2. Client credentials (contoso-batch, aud = gateway only)
  type: http
  seq: 2
}

post {
  url: {{keycloak}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: basic
}

auth:basic {
  username: contoso-batch
  password: {{batchSecret}}
}

body:form-urlencoded {
  grant_type: client_credentials
  scope: gateway:call
}

script:post-response {
  bru.setVar("subjectToken", res.body.access_token);
}

tests {
  test("issues an access token and no refresh token", function() {
    expect(res.status).to.equal(200);
    expect(res.body.access_token).to.be.a("string");
    expect(res.body.refresh_token).to.equal(undefined);
  });
}
