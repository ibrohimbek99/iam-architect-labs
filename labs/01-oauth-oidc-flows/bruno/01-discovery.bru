meta {
  name: 1. OIDC discovery
  type: http
  seq: 1
}

get {
  url: {{keycloak}}/realms/{{realm}}/.well-known/openid-configuration
  body: none
  auth: none
}

tests {
  test("advertises PKCE S256 and token exchange", function() {
    expect(res.status).to.equal(200);
    expect(res.body.code_challenge_methods_supported).to.include("S256");
    expect(res.body.grant_types_supported).to.include("urn:ietf:params:oauth:grant-type:token-exchange");
  });
}
