{
  "realm": "contoso",
  "displayName": "Contoso Bank (lab)",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "defaultDefaultClientScopes": ["basic", "profile"],
  "defaultOptionalClientScopes": [],
  "clientScopes": [
    {
      "name": "basic",
      "description": "Subject claim (required since Keycloak 25: without this scope tokens have no sub)",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false", "display.on.consent.screen": "false" },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": { "access.token.claim": "true", "introspection.token.claim": "true" }
        }
      ]
    },
    {
      "name": "profile",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "true" },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "accounts:read",
      "description": "Read account summaries. Adds the Accounts API to aud.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "true" },
      "protocolMappers": [
        {
          "name": "aud-accounts-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "contoso-accounts-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "transfers:write",
      "description": "Initiate transfers. Adds the Accounts API to aud.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "true" },
      "protocolMappers": [
        {
          "name": "aud-accounts-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "contoso-accounts-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "gateway:call",
      "description": "Call the gateway. Adds contoso-gateway to aud, so the gateway may exchange the token.",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "true" },
      "protocolMappers": [
        {
          "name": "aud-gateway",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "contoso-gateway",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "contoso-accounts-api",
      "name": "Contoso Accounts API (resource server; never requests tokens)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "contoso-cli",
      "name": "Contoso CLI (public client: auth code + PKCE)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://127.0.0.1:8765/callback"],
      "webOrigins": [],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "defaultClientScopes": ["basic", "profile"],
      "optionalClientScopes": ["accounts:read", "transfers:write", "gateway:call"]
    },
    {
      "clientId": "contoso-batch",
      "name": "Contoso batch job (confidential: client credentials)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "lab-only-batch-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["basic", "profile"],
      "optionalClientScopes": ["accounts:read", "gateway:call"]
    },
    {
      "clientId": "contoso-batch-dpop",
      "name": "Contoso batch job with DPoP-bound tokens (RFC 9449)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "lab-only-dpop-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": { "dpop.bound.access.tokens": "true" },
      "defaultClientScopes": ["basic", "profile"],
      "optionalClientScopes": ["accounts:read"]
    },
    {
      "clientId": "contoso-gateway",
      "name": "Contoso gateway (confidential: standard token exchange)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "lab-only-gateway-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": { "standard.token.exchange.enabled": "true" },
      "defaultClientScopes": ["basic"],
      "optionalClientScopes": ["accounts:read"]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@contoso.example",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Example",
      "credentials": [{ "type": "password", "value": "alice-lab-only", "temporary": false }]
    },
    {
      "username": "service-account-contoso-batch",
      "enabled": true,
      "serviceAccountClientId": "contoso-batch"
    },
    {
      "username": "service-account-contoso-batch-dpop",
      "enabled": true,
      "serviceAccountClientId": "contoso-batch-dpop"
    }
  ]
}
